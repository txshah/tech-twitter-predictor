# Copy this to backend/.env and fill in your values

# OpenAI API key — used for screenshot OCR and report parsing
OPENAI_API_KEY=your_openai_key_here

# Mirofish backend URL (clone https://github.com/666ghj/MiroFish and run it separately)
MIROFISH_BASE_URL=http://localhost:5001

# Set to true to skip Mirofish and return mock data (great for UI development)
MOCK_MODE=true

# Port for this app's backend
PORT=3001
